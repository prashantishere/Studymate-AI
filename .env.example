# StudyMate AI - Environment Configuration
# Run Gemma 4 directly with the Gemini API (via Google AI Studio)
# Documentation: https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Supported Gemma 4 models on Gemini API:
# - gemma-4-26b-a4b-it
# - gemma-4-31b-it
# - gemma-2-9b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Set to 1 for offline testing without external API calls, or 0 for live model calls
STUDYMATE_MOCK_AI=0
